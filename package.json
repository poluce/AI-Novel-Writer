{
  "name": "ai-novel-writer",
  "version": "1.1.0",
  "description": "AI Novel Writer - a local-first production workspace for long-form fiction",
  "author": "AI Novel Writer Maintainers",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc && vite build",
    "build-storybook": "storybook build",
    "build:mac:arm64:artifacts": "pnpm run clean:build && pnpm run typecheck && pnpm run rebuild:electron && clang -fobjc-arc -framework Foundation electron/security/darwin-safe-file-system.m -o electron/security/darwin-safe-file-system && chmod +x electron/security/darwin-safe-file-system && vite build && node scripts/build-release-vector-smoke-runner.mjs && electron-builder --mac --arm64 --publish never",
    "build:mac:artifacts": "pnpm run build:mac:arm64:artifacts",
    "build:mac:x64:artifacts": "pnpm run clean:build && pnpm run typecheck && pnpm run rebuild:electron && clang -fobjc-arc -framework Foundation electron/security/darwin-safe-file-system.m -o electron/security/darwin-safe-file-system && chmod +x electron/security/darwin-safe-file-system && vite build && node scripts/build-release-vector-smoke-runner.mjs && electron-builder --mac --x64 --publish never",
    "build:win": "pnpm run release:win:verify",
    "build:win-dir": "pnpm run clean:build && pnpm run typecheck && pnpm run rebuild:electron && vite build && electron-builder --win dir --x64 && pnpm run verify:win-package",
    "build:win:artifacts": "node scripts/require-release-gate.mjs && pnpm run rebuild:electron && tsc && vite build && electron-builder --win --x64 --publish never",
    "check:i18n": "node scripts/check-i18n-coverage.mjs",
    "check:prompts": "node scripts/generate-prompt-modules.mjs --check",
    "clean:build": "node scripts/clean-build-output.mjs",
    "dev": "vite",
    "generate:prompts": "node scripts/generate-prompt-modules.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prebuild": "node scripts/generate-prompt-modules.mjs",
    "predev": "node scripts/prepare-native-for-electron.mjs",
    "prepare:native-node": "node scripts/prepare-native-for-node.mjs",
    "pretest": "node scripts/generate-prompt-modules.mjs && node scripts/check-native-node-abi.mjs",
    "preview": "vite preview",
    "rebuild": "pnpm run rebuild:electron",
    "rebuild:electron": "node scripts/prepare-native-for-electron.mjs",
    "release:win:verify": "node scripts/release-win-verify.mjs",
    "smoke:mac-dmg": "bash scripts/smoke-macos-dmg.sh",
    "smoke:win-app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-win-app.ps1",
    "smoke:win-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-win-installer.ps1",
    "smoke:win-v025-upgrade": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-win-v025-upgrade.ps1",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:node": "node scripts/run-node-test-suite.mjs",
    "test:renderer-surface:e2e": "node scripts/renderer-surface-e2e.mjs",
    "typecheck": "tsc --noEmit",
    "verify:github-update-release": "node scripts/verify-github-update-release.mjs",
    "verify:win-package": "node scripts/verify-win-package.mjs",
    "verify:win-update-artifacts": "node scripts/verify-win-update-artifacts.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@lancedb/lancedb": "0.22.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@uiw/react-codemirror": "^4.25.9",
    "apache-arrow": "^18.1.0",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "6.8.9",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-resizable-panels": "^4.9.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "yauzl": "^2.10.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@electron/rebuild": "^4.2.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-onboarding": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.10",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^10.5.10",
    "playwright": "^1.59.1",
    "postcss": "^8.5.18",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@lancedb/lancedb-darwin-arm64": "0.22.3",
    "@lancedb/lancedb-darwin-x64": "0.22.3",
    "@lancedb/lancedb-win32-x64-msvc": "0.22.3"
  }
}
